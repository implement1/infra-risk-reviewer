{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:p02:schema:run-result:v2",
 "title": "P02 run result v2 (Phase 2 deterministic IaC baseline; emitted by 'p02review review')",
 "description": "Additive successor of p02.run-result.v1. v1 remains the contract of 'p02review ingest'. 'no_blocking_findings_detected' means only that the baseline rules detected no blocking finding with complete coverage; it never asserts safety.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "tool",
  "run_id",
  "status",
  "input_identity",
  "source_inventory",
  "coverage",
  "tool_status",
  "rule_coverage",
  "evidence",
  "findings",
  "policy",
  "errors",
  "errors_total",
  "errors_truncated",
  "limits",
  "external_actions",
  "run_context"
 ],
 "$defs": {
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "error": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "code",
    "message"
   ],
   "properties": {
    "code": {
     "type": "string",
     "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "message": {
     "type": "string",
     "maxLength": 400
    },
    "path": {
     "type": "string",
     "maxLength": 200
    },
    "line": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "note": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "code",
    "message",
    "line"
   ],
   "properties": {
    "code": {
     "type": "string",
     "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "message": {
     "type": "string",
     "maxLength": 400
    },
    "line": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1
    }
   }
  }
 },
 "properties": {
  "schema_version": {
   "const": "p02.run-result.v2"
  },
  "tool": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "version",
    "phase"
   ],
   "properties": {
    "name": {
     "const": "p02review"
    },
    "version": {
     "type": "string"
    },
    "phase": {
     "const": "phase-2-deterministic-iac-baseline"
    }
   }
  },
  "run_id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9._-]{1,64}$"
  },
  "status": {
   "enum": [
    "completed",
    "rejected",
    "internal_error"
   ]
  },
  "input_identity": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "scheme",
      "origin",
      "fixture_id",
      "content_identity_sha256",
      "manifest_digest_sha256",
      "input_identity_sha256",
      "file_count",
      "total_bytes"
     ],
     "properties": {
      "scheme": {
       "const": "p02.input-identity.v1"
      },
      "origin": {
       "const": "fixture"
      },
      "fixture_id": {
       "type": "string"
      },
      "content_identity_sha256": {
       "$ref": "#/$defs/sha256"
      },
      "manifest_digest_sha256": {
       "$ref": "#/$defs/sha256"
      },
      "input_identity_sha256": {
       "$ref": "#/$defs/sha256"
      },
      "file_count": {
       "type": "integer",
       "minimum": 1
      },
      "total_bytes": {
       "type": "integer",
       "minimum": 0
      }
     }
    }
   ]
  },
  "source_inventory": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "path",
     "kind",
     "size_bytes",
     "sha256",
     "line_count",
     "encoding"
    ],
    "properties": {
     "path": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "terraform",
       "terraform-vars",
       "yaml",
       "json",
       "diff",
       "kubernetes",
       "helm-rendered",
       "terraform-plan"
      ]
     },
     "size_bytes": {
      "type": "integer",
      "minimum": 0
     },
     "sha256": {
      "$ref": "#/$defs/sha256"
     },
     "line_count": {
      "type": "integer",
      "minimum": 0
     },
     "encoding": {
      "const": "utf-8"
     }
    }
   }
  },
  "coverage": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "state",
    "analysis_complete",
    "files_declared",
    "files_accepted",
    "bytes_accepted",
    "files",
    "statement"
   ],
   "properties": {
    "state": {
     "enum": [
      "analyzed_complete",
      "analyzed_incomplete",
      "input_rejected",
      "not_assessed_internal_error"
     ]
    },
    "analysis_complete": {
     "type": "boolean"
    },
    "files_declared": {
     "type": "integer",
     "minimum": 0
    },
    "files_accepted": {
     "type": "integer",
     "minimum": 0
    },
    "bytes_accepted": {
     "type": "integer",
     "minimum": 0
    },
    "files": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "path",
       "kind",
       "analyzer",
       "analyzer_version",
       "status",
       "objects_analyzed",
       "notes",
       "notes_truncated"
      ],
      "properties": {
       "path": {
        "type": "string"
       },
       "kind": {
        "type": "string"
       },
       "analyzer": {
        "type": [
         "string",
         "null"
        ]
       },
       "analyzer_version": {
        "type": [
         "string",
         "null"
        ]
       },
       "status": {
        "enum": [
         "analyzed",
         "partial",
         "unsupported",
         "parse_error",
         "not_analyzed"
        ]
       },
       "objects_analyzed": {
        "type": "integer",
        "minimum": 0
       },
       "notes": {
        "type": "array",
        "maxItems": 50,
        "items": {
         "$ref": "#/$defs/note"
        }
       },
       "notes_truncated": {
        "type": "boolean"
       }
      }
     }
    },
    "statement": {
     "type": "string"
    }
   }
  },
  "tool_status": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "status",
     "kind"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "deterministic",
       "model"
      ]
     },
     "status": {
      "enum": [
       "ok",
       "rejected",
       "error",
       "no_hits",
       "hits",
       "not_run",
       "partial",
       "unavailable",
       "not_applicable",
       "not_used",
       "disabled"
      ]
     }
    }
   }
  },
  "rule_coverage": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "rule_id",
     "analyzer",
     "evaluations",
     "findings"
    ],
    "properties": {
     "rule_id": {
      "type": "string"
     },
     "analyzer": {
      "type": "string"
     },
     "evaluations": {
      "type": "integer",
      "minimum": 0
     },
     "findings": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  },
  "evidence": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "kind",
     "path",
     "line_start",
     "line_end",
     "plan_address",
     "json_pointer",
     "source_sha256",
     "analyzer",
     "analyzer_version",
     "rule_id",
     "observation",
     "validation_status"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^E-[0-9a-f]{16}$"
     },
     "kind": {
      "enum": [
       "source_lines",
       "plan_resource"
      ]
     },
     "path": {
      "type": "string"
     },
     "line_start": {
      "type": [
       "integer",
       "null"
      ],
      "minimum": 1
     },
     "line_end": {
      "type": [
       "integer",
       "null"
      ],
      "minimum": 1
     },
     "plan_address": {
      "type": [
       "string",
       "null"
      ]
     },
     "json_pointer": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^/"
     },
     "source_sha256": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "$ref": "#/$defs/sha256"
       }
      ]
     },
     "analyzer": {
      "type": "string"
     },
     "analyzer_version": {
      "type": "string"
     },
     "rule_id": {
      "type": "string"
     },
     "observation": {
      "type": "string",
      "maxLength": 600
     },
     "validation_status": {
      "enum": [
       "resolved_against_inventory",
       "digest_withheld"
      ]
     }
    }
   }
  },
  "findings": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "rule_id",
     "category",
     "severity",
     "state",
     "provenance",
     "analyzer",
     "resource",
     "location",
     "evidence_ids",
     "summary",
     "rationale",
     "recommended_check"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^F-[0-9a-f]{16}$"
     },
     "rule_id": {
      "type": "string"
     },
     "category": {
      "enum": [
       "identity",
       "network",
       "availability",
       "secrets",
       "kubernetes",
       "cost",
       "policy",
       "unknown"
      ]
     },
     "severity": {
      "enum": [
       "info",
       "low",
       "medium",
       "high",
       "critical",
       "unknown"
      ]
     },
     "state": {
      "enum": [
       "confirmed_by_rule",
       "suspected",
       "insufficient_evidence",
       "unsupported"
      ]
     },
     "provenance": {
      "const": "deterministic"
     },
     "analyzer": {
      "type": "string"
     },
     "resource": {
      "type": "string"
     },
     "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "path",
       "line_start",
       "line_end",
       "plan_address"
      ],
      "properties": {
       "path": {
        "type": "string"
       },
       "line_start": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 1
       },
       "line_end": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 1
       },
       "plan_address": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string"
      }
     },
     "summary": {
      "type": "string"
     },
     "rationale": {
      "type": "string"
     },
     "recommended_check": {
      "type": "string"
     }
    }
   }
  },
  "policy": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "decision",
    "risk_assessment_performed",
    "human_review_required",
    "blocking_review_required",
    "reasons",
    "statement",
    "rubric"
   ],
   "properties": {
    "decision": {
     "enum": [
      "review_required",
      "no_blocking_findings_detected",
      "inconclusive"
     ]
    },
    "risk_assessment_performed": {
     "type": "boolean"
    },
    "human_review_required": {
     "const": true
    },
    "blocking_review_required": {
     "type": "boolean"
    },
    "reasons": {
     "type": "array",
     "minItems": 1,
     "items": {
      "enum": [
       "INPUT_REJECTED",
       "SUSPECTED_SECRET_BLOCKED",
       "INTERNAL_ERROR",
       "CONFIRMED_HIGH_SEVERITY_FINDING",
       "SUSPECTED_HIGH_SEVERITY_FINDING",
       "INSUFFICIENT_EVIDENCE_FINDING",
       "COVERAGE_INCOMPLETE",
       "NO_BLOCKING_FINDING_IN_BASELINE_RULES"
      ]
     }
    },
    "statement": {
     "type": "string"
    },
    "rubric": {
     "type": "string"
    }
   }
  },
  "errors": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/error"
   }
  },
  "errors_total": {
   "type": "integer",
   "minimum": 0
  },
  "errors_truncated": {
   "type": "boolean"
  },
  "limits": {
   "type": "object",
   "required": [
    "values",
    "fingerprint_sha256",
    "note"
   ],
   "properties": {
    "values": {
     "type": "object"
    },
    "fingerprint_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "external_actions": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "network_calls",
    "model_calls",
    "subprocess_invocations",
    "repository_writes",
    "cloud_api_calls",
    "basis"
   ],
   "properties": {
    "network_calls": {
     "const": 0
    },
    "model_calls": {
     "const": 0
    },
    "subprocess_invocations": {
     "const": 0
    },
    "repository_writes": {
     "const": 0
    },
    "cloud_api_calls": {
     "const": 0
    },
    "basis": {
     "type": "string"
    }
   }
  },
  "run_context": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "elapsed_ms",
    "note"
   ],
   "properties": {
    "elapsed_ms": {
     "type": "integer",
     "minimum": 0
    },
    "note": {
     "type": "string"
    }
   }
  }
 }
}